# Local development settings. Do not use these values in production.
POSTGRES_DSN=postgres://idp:idp@localhost:5432/idp?sslmode=disable
REDIS_HOST=localhost
REDIS_PORT=6379
AUTH_ISSUER=http://localhost:8080
# Leave empty to generate an ephemeral key (dev only). For a real key:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out signing.pem
AUTH_SIGNING_KEY_PATH=
# Plain HTTP on localhost: browsers drop Secure cookies otherwise.
HTTP_SECURE_COOKIES=false
LOG_LEVEL=debug
